# 前端依赖、构建产物与工具缓存；保留依赖锁文件
node_modules/
/dist/
/.vefaas/
.vite/
*.tsbuildinfo

# Python 虚拟环境、字节码与检查缓存
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/

# 本机业务数据和临时输出；示例项目仍保留在 examples 中
/data/
/output/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# 本地环境配置；允许提交不含真实凭据的示例模板
.env
.env.*
!.env.example
!.env.*.example

# 测试报告、浏览器自动化输出和覆盖率
/.playwright-cli/
/playwright-report/
/test-results/
/coverage/
/htmlcov/
.coverage
.coverage.*
/coverage.xml

# 运行日志
*.log

# 编辑器临时文件；不整体忽略可共享的 .vscode 配置
.idea/
*.suo
*.user
*.swp
*.swo
*~

# Windows 和 macOS 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
